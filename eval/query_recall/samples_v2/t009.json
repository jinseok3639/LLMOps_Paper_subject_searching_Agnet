  "source_quotes": {
   "gap": [
    {
     "id": "g1",
     "quote": "recent work shows that substantial amounts of copyrighted text can be extracted from open-weight models.",
     "page": 1,
     "verified": true,
     "check": "strict"
    },
    {
     "id": "g2",
     "quote": "it remains an open question if similar extraction is feasible for production LLMs, given the safety measures these systems implement.",
     "page": 1,
     "verified": true,
     "check": "strict"
    }
   ],
   "approach": [
    {
     "id": "a1",
     "quote": "a two-phase procedure: (1) an initial probe to test for extraction feasibility, which sometimes uses a Best-of-N (BoN) jailbreak, followed by (2) iterative continuation prompts to attempt to extract the book.",
     "page": 1,
     "verified": true,
     "check": "strict"
    }
   ],
   "evaluation": [
    {
     "id": "e1",
     "quote": "we measure extraction success with a score computed from a block-based approximation of longest common substring (nv-recall).",
     "page": 1,
     "verified": true,
     "check": "strict"
    }
   ]
  },
